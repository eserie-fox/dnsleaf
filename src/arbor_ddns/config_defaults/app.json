{
  "config_version": 1,
  "discovery": {
    "pct_bin": "pct",
    "qm_bin": "qm",
    "shell_bin": "sh"
  },
  "systemd": {
    "systemctl_bin": "systemctl",
    "unit_dir": "/etc/systemd/system"
  },
  "workspace_scaffold": {
    "config_version": 1,
    "provider": "cloudflare",
    "zone_name": "example.com",
    "zone_id": null,
    "api_token_file": "secrets/cloudflare_api_token.txt",
    "default_ttl": 120,
    "default_proxied": false,
    "systemd": {
      "on_boot_sec": "2min",
      "on_unit_active_sec": "10min",
      "run_sync_after_apply": false
    },
    "apply": {
      "prune_managed_records": false
    }
  }
}
